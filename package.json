{
  "name": "bulk-email-sender",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "send": "bun src/mainfn.ts",
    "clear": "bun src/cleardb.ts",
    "test:tracking": "bun scripts/test-supabase-tracking.ts",
    "setup:supabase": "bun scripts/setup-supabase-migration.ts",
    "sync": "bun src/sync-tracking.ts",
    "sync:tracking": "bun src/sync-tracking.ts",
    "deploy:tracking": "bun scripts/deploy-track-open.ts",
    "check:tracking": "bun -e \"import { checkTrackingPixelEndpoint } from './src/tracking/supabase.ts'; const r = await checkTrackingPixelEndpoint(); console.log(r); process.exit(r.ok ? 0 : 1);\"",
    "test:tracking:full": "bun scripts/test-full-tracking-sync.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.106.2",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "google-auth-library": "^10.6.2",
    "google-spreadsheet": "^5.2.0",
    "mongodb": "^6.15.0",
    "morgan": "^1.10.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.21.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
